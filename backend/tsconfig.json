{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "rootDir": "src", "outDir": "lib", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
